#!/usr/bin/env bash
# Real-board ArduinoOTA test-harness runner. It deliberately owns no Wi-Fi adapter:
# station traffic uses the normal LAN route, unlike the portal runner.
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_dir"
# shellcheck source=tools/lib/platformio.sh
source "$project_dir/tools/lib/platformio.sh"
# shellcheck source=tools/lib/ota-fixture-identity.sh
source "$project_dir/tools/lib/ota-fixture-identity.sh"
# shellcheck source=tools/lib/harness-locks.sh
source "$project_dir/tools/lib/harness-locks.sh"

# Keep the physical runner responsive while its serial/adapter ownership is
# exclusive. Developers may opt in to more parallel build jobs explicitly.
export PLATFORMIO_RUN_JOBS="${PLATFORMIO_RUN_JOBS:-2}"

usage() {
    cat <<'EOF' >&2
Usage:
  ./tools/ota-hardware doctor --platform esp8266|esp32
  ./tools/ota-hardware arduino --platform esp8266|esp32 --port DEVICE
      [--env-file test/.env] [--auth protected|open|both]
      [--host-port PORT] [--device-ip IPv4] [--output DIRECTORY]
      [--defer-mdns]
  ./tools/ota-hardware cleanup --platform esp8266|esp32 --port DEVICE

Normal ArduinoOTA mode proves both Avahi and the system resolver can resolve
the device hostname, and uploads to that hostname. --device-ip is a labelled
diagnostic transport mode and never passes the mDNS test harness.
EOF
    exit 2
}

command="${1:-}"
[[ -n "$command" ]] || usage
shift || true

platform=""
serial_port=""
env_file="test/.env"
auth_mode="protected"
host_port="43123"
device_ip=""
output_root=""
defer_mdns="no"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --platform) [[ $# -ge 2 ]] || usage; platform="$2"; shift 2 ;;
        --port) [[ $# -ge 2 ]] || usage; serial_port="$2"; shift 2 ;;
        --env-file) [[ $# -ge 2 ]] || usage; env_file="$2"; shift 2 ;;
        --auth) [[ $# -ge 2 ]] || usage; auth_mode="$2"; shift 2 ;;
        --host-port) [[ $# -ge 2 ]] || usage; host_port="$2"; shift 2 ;;
        --device-ip) [[ $# -ge 2 ]] || usage; device_ip="$2"; shift 2 ;;
        --output) [[ $# -ge 2 ]] || usage; output_root="$2"; shift 2 ;;
        --defer-mdns) defer_mdns="yes"; shift ;;
        *) usage ;;
    esac
done

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Required command not found: $1" >&2
        return 1
    }
}

need_python_serial() {
    python3 -c 'import serial' >/dev/null 2>&1 || {
        echo "Python module 'serial' (pyserial) is required for passive OTA capture." >&2
        return 1
    }
}

validate_platform() {
    [[ "$platform" == "esp8266" || "$platform" == "esp32" ]] || usage
}

validate_ipv4() {
    local value="$1" octet
    local -a octets
    [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || {
        echo "Not an IPv4 address: $1" >&2
        return 1
    }
    IFS=. read -r -a octets <<<"$value"
    [[ ${#octets[@]} -eq 4 ]] || {
        echo "Not an IPv4 address: $1" >&2
        return 1
    }
    for octet in "${octets[@]}"; do
        [[ "$octet" =~ ^[0-9]{1,3}$ ]] && (( 10#$octet <= 255 )) || {
            echo "Not an IPv4 address: $1" >&2
            return 1
        }
    done
}

validate_args() {
    validate_platform
    case "$auth_mode" in protected|open|both) ;; *) echo "--auth must be protected, open, or both" >&2; usage ;; esac
    [[ "$host_port" =~ ^[0-9]+$ ]] && (( host_port >= 1024 && host_port <= 65535 )) || {
        echo "--host-port must be from 1024 through 65535." >&2
        return 1
    }
    [[ -n "$serial_port" && -e "$serial_port" ]] || {
        echo "Serial port not found: $serial_port" >&2
        return 1
    }
    [[ -z "$device_ip" ]] || validate_ipv4 "$device_ip"
    if [[ "$defer_mdns" == "yes" ]]; then
        [[ "$platform" == "esp8266" ]] || { echo "--defer-mdns is ESP8266-only." >&2; return 1; }
        [[ -n "$device_ip" ]] || { echo "--defer-mdns requires --device-ip." >&2; return 1; }
    fi
}

validate_doctor_args() {
    validate_platform
    # `doctor` intentionally does not touch a board, read test credentials,
    # open an OTA callback listener, or select diagnostic transport. Reject
    # later-run flags instead of letting an invalid command appear healthy.
    [[ -z "$serial_port$device_ip$output_root" && "$defer_mdns" == no && \
       "$auth_mode" == protected && "$host_port" == 43123 && "$env_file" == test/.env ]] || {
        echo "ArduinoOTA doctor accepts only --platform." >&2
        return 1
    }
}

validate_cleanup_args() {
    validate_platform
    # Cleanup deliberately erases a named board. Reject every argument that
    # belongs to an OTA run so a copied command cannot quietly ignore a
    # requested mode or diagnostic setting before touching flash.
    [[ -z "$device_ip$output_root" && "$defer_mdns" == no && \
       "$auth_mode" == protected && "$host_port" == 43123 && "$env_file" == test/.env ]] || {
        echo "ArduinoOTA cleanup accepts only --platform and --port." >&2
        return 1
    }
}

lock_board() {
    df_harness_lock_serial_port "$serial_port"
}

profile_file=""
profile_build_dir=""
profile_private_dir=""
run_dir=""
monitor_pid=""
serial_capture_pid=""
serial_capture_ready_file=""
serial_capture_log=""
wifi_ssid=""
wifi_password=""
device_password=""
device_name=""
device_hostname=""
run_token=""
environment=""
firmware_a=""
firmware_b=""
firmware_a_artifact=""
firmware_b_artifact=""

cleanup() {
    local status="${1:-0}"
    trap - EXIT HUP INT TERM
    [[ -z "$monitor_pid" ]] || kill "$monitor_pid" >/dev/null 2>&1 || true
    [[ -z "$monitor_pid" ]] || wait "$monitor_pid" >/dev/null 2>&1 || true
    [[ -z "$serial_capture_pid" ]] || kill "$serial_capture_pid" >/dev/null 2>&1 || true
    [[ -z "$serial_capture_pid" ]] || wait "$serial_capture_pid" >/dev/null 2>&1 || true
    df_remove_ota_fixture_identity
    [[ -z "$profile_file" ]] || rm -f -- "$profile_file" "${profile_file}.tmp"
    exit "$status"
}

need_common() {
    df_pio_available
    need python3
    need curl
    need ip
    need flock
    need timeout
    need getent
    # Normal mode proves mDNS resolution; forced-defer also needs Avahi to
    # prove that the deliberately unique hostname remains absent.
    [[ -n "$device_ip" && "$defer_mdns" != "yes" ]] || need avahi-resolve
}

prepare_output() {
    [[ -n "$output_root" ]] || output_root="$project_dir/artifacts/ota/$(date -u +%Y%m%dT%H%M%SZ)-$platform"
    install -d -m 700 "$output_root"
    output_root="$(cd "$output_root" && pwd)"
}

json_escape() {
    python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
}

strip_quotes() {
    local value="$1"
    if [[ "$value" == \"*\" ]]; then
        value="${value#\"}"
        value="${value%\"}"
    elif [[ "$value" == \'*\' ]]; then
        value="${value#\'}"
        value="${value%\'}"
    fi
    printf '%s' "$value"
}

load_station_env() {
    local line value
    [[ -r "$env_file" ]] || {
        echo "Missing local test credentials: $env_file (copy test/.env.example)." >&2
        return 1
    }
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        case "$line" in
            DEVICEFRAMEWORK_TEST_WIFI_SSID=*) value="${line#*=}"; wifi_ssid="$(strip_quotes "$value")" ;;
            DEVICEFRAMEWORK_TEST_WIFI_PASSWORD=*) value="${line#*=}"; wifi_password="$(strip_quotes "$value")" ;;
            # A shared test/.env can contain optional values used by the normal
            # hardware or fixture runners (for example, a local fetcher port).
            # ArduinoOTA consumes only station credentials, so retain a strict
            # namespace boundary without making that shared file unusable.
            DEVICEFRAMEWORK_TEST_*=*) ;;
            *) echo "Unexpected key in $env_file; use the DEVICEFRAMEWORK_TEST_ namespace." >&2; return 1 ;;
        esac
    done < "$env_file"
    [[ -n "$wifi_ssid" && -n "$wifi_password" ]] || {
        echo "DEVICEFRAMEWORK_TEST_WIFI_SSID and DEVICEFRAMEWORK_TEST_WIFI_PASSWORD are required." >&2
        return 1
    }
}

set_identity() {
    local platform_token auth_token prefix
    case "$platform" in
        esp8266) platform_token=8266 ;;
        esp32) platform_token=32 ;;
        *) return 1 ;;
    esac
    case "$auth_mode" in
        protected)
            auth_token=p
            device_password="ota-test-password"
            ;;
        open)
            auth_token=o
            device_password=""
            ;;
        *) return 1 ;;
    esac
    if [[ "$defer_mdns" == "yes" ]]; then
        prefix=dfotad
    else
        prefix=dfota
    fi
    # DeviceFramework's managed device-name field is capped at 24 characters.
    # A per-run hostname avoids accepting an mDNS record from an earlier run;
    # the compact ESP8266 deferred form is exactly within that bound.
    device_name="${prefix}-${platform_token}-${auth_token}-${run_token}"
    device_hostname="$device_name.local"
}

write_profile() {
    local ssid_json wifi_json name_json device_json profile_temporary
    ssid_json="$(printf '%s' "$wifi_ssid" | json_escape)"
    wifi_json="$(printf '%s' "$wifi_password" | json_escape)"
    name_json="$(printf '%s' "$device_name" | json_escape)"
    device_json="$(printf '%s' "$device_password" | json_escape)"
    # PlatformIO includes `custom_device_profile` in its environment
    # fingerprint.  A per-run mktemp path therefore invalidates every object,
    # even though only DeviceFrameworkProvisioning.cpp includes this header.
    # PlatformIO clears its configured build root before it executes the
    # profile hook, so keep the stable pathname in a sibling private
    # directory. The content remains per-run and cleanup removes it on exit.
    profile_file="$profile_private_dir/deviceframework-ota-profile.json"
    profile_temporary="${profile_file}.tmp"
    {
        printf '%s\n' '{'
        printf '%s\n' '  "format": 2,'
        printf '%s\n' '  "application": "deviceframework",'
        printf '  "profile": { "id": "ota-lan-%s-%s", "revision": 1, "policy": "bootstrap" },\n' "$platform" "$auth_mode"
        printf '  "device_password": %s,\n' "$device_json"
        printf '%s\n' '  "wifi": { "profiles": ['
        printf '    { "ssid": %s, "password": %s }\n' "$ssid_json" "$wifi_json"
        printf '%s\n' '  ] },'
        printf '  "parameters": { "device": %s }\n' "$name_json"
        printf '%s\n' '}'
    } > "$profile_temporary"
    chmod 600 "$profile_temporary"
    mv -f -- "$profile_temporary" "$profile_file"
}

prepare_private_profile_build() {
    local build_key
    build_key="$platform"

    # profile.py deliberately compiles station credentials into a generated
    # header. Keep that header and its object cache in one ignored, mode-0700
    # directory for this checkout and test mode. A new run still gets its own
    # mode-0700 evidence directory, but need not rebuild every unchanged
    # framework object or download packages again.
    profile_build_dir="$project_dir/.pio/ota-hardware/$build_key"
    profile_private_dir="$project_dir/.pio/ota-hardware-profiles/$build_key"
    install -d -m 700 "$profile_build_dir"
    install -d -m 700 "$profile_private_dir"
}

pio_with_fixture() {
    local image="$1" transport="$2" fixture_image fixture_version
    shift 2
    case "$image" in
        a) fixture_image=A; fixture_version="0.0.0-${transport}-ota-a" ;;
        b) fixture_image=B; fixture_version="0.0.0-${transport}-ota-b" ;;
        *) echo "Unknown ArduinoOTA fixture identity: $image" >&2; return 2 ;;
    esac
    df_write_ota_fixture_identity "$fixture_image" "$fixture_version"
    # PlatformIO's native override takes precedence over a developer's
    # optional local-source selector without creating another project config.
    DEVICEFRAMEWORK_OTA_PROFILE="$profile_file" \
        PLATFORMIO_BUILD_DIR="$profile_build_dir" df_pio "$@"
}

environment_for() {
    if [[ "$defer_mdns" == "yes" ]]; then
        printf '%s_udp_ota_deferred\n' "$platform"
    else
        printf '%s_udp_ota\n' "$platform"
    fi
}

wait_for_serial() {
    local attempt
    for attempt in $(seq 1 15); do
        [[ -e "$serial_port" ]] && return 0
        sleep 1
    done
    echo "Serial port did not return after erase: $serial_port" >&2
    return 1
}

build_image() {
    local image="$1" source artifact
    environment="$(environment_for)"
    df_lock_ota_fixture_environment "$environment"
    pio_with_fixture "$image" udp run -d test/ota-harness -e "$environment"
    source="$profile_build_dir/$environment/firmware.bin"
    [[ -s "$source" ]] || {
        echo "OTA fixture build did not produce image ${image^^}." >&2
        return 1
    }
    case "$image" in
        a)
            artifact="$run_dir/$platform-udp-ota-a.bin"
            firmware_a="$source"
            firmware_a_artifact="$artifact"
            ;;
        b)
            artifact="$run_dir/$platform-udp-ota-b.bin"
            firmware_b="$source"
            firmware_b_artifact="$artifact"
            ;;
        *) return 2 ;;
    esac
    install -m 600 "$source" "$artifact"
}

esp32_slot_size() {
    local partition="$1" subtype="$2" value
    value="$(awk -F, -v partition="$partition" -v subtype="$subtype" '
      function trim(x) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x }
      /^[[:space:]]*#/ || NF < 5 { next }
      trim($1) == partition && trim($2) == "app" && trim($3) == subtype { print trim($5); exit }
    ' "$project_dir/partitions/esp32_ota_4m_no_fs.csv")"
    [[ "$value" =~ ^0x[0-9A-Fa-f]+$ ]] || {
        echo "No valid ESP32 $partition OTA slot." >&2
        return 1
    }
    printf '%d\n' "$((value))"
}

assert_fits() {
    local image="$1" capacity="$2" label="$3" size
    size="$(wc -c < "$image" | tr -d '[:space:]')"
    [[ "$capacity" =~ ^[0-9]+$ && "$capacity" -gt 0 ]] || {
        echo "Invalid OTA capacity." >&2
        return 1
    }
    (( size <= capacity )) || {
        echo "OTA $label ($size bytes) exceeds capacity ($capacity bytes)." >&2
        return 1
    }
    printf 'OTA %s fits: %s <= %s bytes\n' "$label" "$size" "$capacity"
}

flash_a() {
    pio_with_fixture a udp run -d test/ota-harness -e "$environment" -t erase --upload-port "$serial_port"
    wait_for_serial
    pio_with_fixture a udp run -d test/ota-harness -e "$environment" -t upload --upload-port "$serial_port"
    # A is rebuilt immediately before serial upload because PlatformIO uploads
    # its environment output, while B is already preserved as a separate
    # immutable artifact. Verify that this rebuild still matches A exactly.
    cmp -s "$firmware_a" "$firmware_a_artifact" || {
        echo "The PlatformIO A rebuild differs from its immutable artifact." >&2
        return 1
    }
}

resolved_ip=""
transport_endpoint=""
status_endpoint=""
route_source_ip=""
ota_port=""
espota_path=""

mdns_avahi_ipv4() {
    # avahi-resolve can block when the host daemon or multicast path is
    # unhealthy. Bound each lookup so the test-harness deadline stays real.
    timeout 2 avahi-resolve -4 -n "$1" 2>/dev/null |
        awk 'NR == 1 {print $2; exit}' || true
}

mdns_system_ipv4() {
    timeout 2 getent ahostsv4 "$1" 2>/dev/null |
        awk 'NR == 1 {print $1; exit}' || true
}

resolve_mdns() {
    local deadline avahi_ip getent_ip
    deadline=$((SECONDS + 60))
    while (( SECONDS < deadline )); do
        # A just-flashed board has no hostname until it joins Wi-Fi.  Preserve
        # the intended polling window under `set -e -o pipefail`.
        avahi_ip="$(mdns_avahi_ipv4 "$device_hostname")"
        getent_ip="$(mdns_system_ipv4 "$device_hostname")"
        if [[ -n "$avahi_ip" && "$avahi_ip" == "$getent_ip" ]] && validate_ipv4 "$avahi_ip"; then
            resolved_ip="$avahi_ip"
            transport_endpoint="$device_hostname"
            status_endpoint="$device_hostname"
            echo "mDNS: $device_hostname -> $resolved_ip (Avahi and system resolver agree)"
            return 0
        fi
        sleep 1
    done
    echo "mDNS failed: both Avahi and the system resolver must resolve $device_hostname." >&2
    return 1
}

assert_mdns_absent() {
    local seconds="$1" deadline avahi_ip getent_ip
    deadline=$((SECONDS + seconds))
    while (( SECONDS < deadline )); do
        avahi_ip="$(mdns_avahi_ipv4 "$device_hostname")"
        getent_ip="$(mdns_system_ipv4 "$device_hostname")"
        if [[ -n "$avahi_ip" || -n "$getent_ip" ]]; then
            echo "Deferred hostname unexpectedly resolved: $device_hostname (Avahi=${avahi_ip:-none}, system=${getent_ip:-none})" >&2
            return 1
        fi
        sleep 1
    done
    echo "mDNS: intentionally deferred; no resolver response observed for ${seconds}s."
}

set_target() {
    if [[ "$defer_mdns" == "yes" ]]; then
        resolved_ip="$device_ip"
        transport_endpoint="$device_ip"
        status_endpoint="$device_ip"
        echo "mDNS: intentionally deferred; direct-IP transport mode."
        # Observe a post-boot interval, rather than accepting one negative
        # lookup that could miss a delayed second mDNS owner.
        assert_mdns_absent 10
    elif [[ -n "$device_ip" ]]; then
        resolved_ip="$device_ip"
        transport_endpoint="$device_ip"
        status_endpoint="$device_ip"
        echo "mDNS: not exercised; diagnostic transport mode only."
    else
        resolve_mdns
    fi
}

route_source() {
    local route
    route="$(ip -4 route get "$resolved_ip" 2>/dev/null || true)"
    route_source_ip="$(awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}' <<<"$route")"
    [[ -n "$route_source_ip" ]] || {
        echo "No route source for $resolved_ip: $route" >&2
        return 1
    }
    validate_ipv4 "$route_source_ip"
    printf 'Route: source %s; device UDP %s; callback TCP %s\n' \
        "$route_source_ip" "$ota_port" "$host_port"
    python3 -c 'import socket,sys;s=socket.socket();s.bind((sys.argv[1],int(sys.argv[2])));s.close()' "$route_source_ip" "$host_port" || {
        echo "Cannot bind the callback listener on $route_source_ip:$host_port." >&2
        return 1
    }
}

status_request() {
    local url="http://$status_endpoint/api/status"
    if [[ "$auth_mode" == "protected" ]]; then
        curl --disable --noproxy '*' -sS -f --connect-timeout 2 --max-time 5 -u "admin:$device_password" "$url"
    else
        curl --disable --noproxy '*' -sS -f --connect-timeout 2 --max-time 5 "$url"
    fi
}

status_value() {
    python3 -c 'import json,sys; print(json.load(sys.stdin)["hardware"][sys.argv[1]])' "$1"
}

status_version() {
    printf '%s' "$1" | status_value version 2>/dev/null
}

status_free() {
    printf '%s' "$1" | status_value free_sketch_space 2>/dev/null
}

has_marker() {
    [[ "$(status_version "$1" || true)" == *"$2"* ]]
}

wait_marker() {
    local expected="$1" deadline response
    deadline=$((SECONDS + 90))
    while (( SECONDS < deadline )); do
        response="$(status_request 2>/dev/null || true)"
        if has_marker "$response" "$expected"; then
            printf '%s' "$response"
            return 0
        fi
        sleep 1
    done
    echo "Device did not report marker $expected within 90 seconds." >&2
    return 1
}

verify_a() {
    local response
    response="$(wait_marker 0.0.0-udp-ota-a)"
    echo "Running A marker: $(status_version "$response")"
    if [[ "$platform" == "esp8266" ]]; then
        running_free_space="$(status_free "$response")"
        [[ "$running_free_space" =~ ^[0-9]+$ && "$running_free_space" -gt 4096 ]] || {
            echo "No usable ESP8266 free sketch space." >&2
            return 1
        }
        assert_fits "$firmware_b_artifact" "$(( (running_free_space - 0x1000) & 0xFFFFF000 ))" B
    fi
}

find_espota() {
    # The uploader has to come from precisely the graph that built A and B.
    # `df_pio` scopes its environment to each PlatformIO command, so query the
    # same dedicated package root rather than falling back to a global store.
    local packages_dir
    packages_dir="$(df_pio_packages_dir)"
    case "$platform" in
        esp8266)
            ota_port=8266
            espota_path="$packages_dir/framework-arduinoespressif8266/tools/espota.py"
            ;;
        esp32)
            ota_port=3232
            espota_path="$packages_dir/framework-arduinoespressif32/tools/espota.py"
            ;;
    esac
    [[ -r "$espota_path" ]] || {
        echo "Selected framework espota.py is missing: $espota_path" >&2
        return 1
    }
}

upload() {
    local password="$1" image="$2" log="$3"
    if [[ -n "$password" ]]; then
        timeout 150 python3 "$espota_path" --ip "$transport_endpoint" --host_ip "$route_source_ip" \
            --port "$ota_port" --host_port "$host_port" --auth "$password" --file "$image" >"$log" 2>&1
    else
        timeout 150 python3 "$espota_path" --ip "$transport_endpoint" --host_ip "$route_source_ip" \
            --port "$ota_port" --host_port "$host_port" --file "$image" >"$log" 2>&1
    fi
}

explain_callback_failure() {
    local log="$1"
    # espota has authenticated with the board at this point, then waits for
    # ArduinoOTA's reverse TCP stream.  Make that environmental failure
    # actionable without inspecting or changing the host firewall.
    if grep -Fq '[ERROR]: No response from device' "$log"; then
        cat >&2 <<EOF
ArduinoOTA authenticated, but the board did not open its callback TCP connection.
Allow TCP ${host_port} from ${resolved_ip} to ${route_source_ip} on the selected LAN path,
or choose an already permitted callback port with --host-port. The test harness did not
inspect or change firewall policy.
EOF
    fi
}

monitor_file=""
monitor_ready_file=""
monitor_upload_started_file=""

start_reboot_monitor() {
    monitor_file="$run_dir/reboot-observation.txt"
    monitor_ready_file="$run_dir/reboot-monitor-ready"
    monitor_upload_started_file="$run_dir/reboot-upload-started"
    rm -f -- "$monitor_file" "$monitor_ready_file" "$monitor_upload_started_file"
    (
        seen_a=no
        seen_outage=no
        b_count=0
        # The uploader itself may legitimately spend up to 150 seconds in
        # transfer/authentication. Start observing A before that transfer, so
        # leave room for both the upload and the board's automatic reboot.
        deadline=$((SECONDS + 300))
        while (( SECONDS < deadline )); do
            response="$(status_request 2>/dev/null || true)"
            if has_marker "$response" 0.0.0-udp-ota-a; then
                seen_a=yes
                : > "$monitor_ready_file"
                echo "$(date -u +%H:%M:%S) A reachable" >> "$monitor_file"
            elif [[ -e "$monitor_upload_started_file" ]] && has_marker "$response" 0.0.0-udp-ota-b; then
                ((b_count+=1))
                echo "$(date -u +%H:%M:%S) B reachable $b_count" >> "$monitor_file"
            elif [[ -e "$monitor_upload_started_file" && "$seen_a" == yes ]]; then
                seen_outage=yes
                echo "$(date -u +%H:%M:%S) unavailable" >> "$monitor_file"
            fi
            if [[ "$seen_a" == yes && "$seen_outage" == yes && "$b_count" -ge 2 ]]; then
                echo result=passed >> "$monitor_file"
                exit 0
            fi
            sleep 0.25
        done
        echo "result=failed seen_a=$seen_a seen_outage=$seen_outage b_count=$b_count" >> "$monitor_file"
        exit 1
    ) &
    monitor_pid=$!
    local attempt
    for attempt in $(seq 1 20); do
        [[ -e "$monitor_ready_file" ]] && return 0
        sleep 0.25
    done
    echo "Reboot monitor never observed A before OTA." >&2
    return 1
}

finish_reboot_monitor() {
    if ! wait "$monitor_pid"; then
        monitor_pid=""
        echo "Automatic reboot test-harness check failed:" >&2
        cat "$monitor_file" >&2 || true
        return 1
    fi
    monitor_pid=""
}

assert_http_auth_harness() {
    local expected code deadline
    if [[ "$auth_mode" == protected ]]; then
        expected=401
    else
        expected=200
    fi

    # ESP32 can announce its hostname before its web server accepts a first
    # connection. mDNS success is intentionally checked separately above;
    # wait for the named fixture's HTTP service instead of treating that small
    # startup window as an authentication result. A genuine wrong status is
    # still reported after a bounded deadline.
    deadline=$((SECONDS + 90))
    while (( SECONDS < deadline )); do
        code="$(curl --disable --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' \
            --connect-timeout 2 --max-time 5 "http://$status_endpoint/api/status" 2>/dev/null || true)"
        if [[ "$code" == "$expected" ]]; then
            echo "HTTP auth test-harness check verified for $auth_mode mode."
            return 0
        fi
        sleep 1
    done

    if [[ "$auth_mode" == protected ]]; then
        echo "Protected fixture did not reject anonymous HTTP status access within 90 seconds (last HTTP $code)." >&2
    else
        echo "Open fixture did not allow anonymous HTTP status access within 90 seconds (last HTTP $code)." >&2
    fi
    return 1
}

run_one() {
    local wrong_log correct_log response
    set_identity
    run_dir="$output_root/$auth_mode"
    install -d -m 700 "$run_dir"
    # The A/B header is deliberately run-owned. The profile build cache may be
    # stable for this platform, but no other run can replace this input.
    export DEVICEFRAMEWORK_OTA_IDENTITY_DIR="$run_dir/ota-fixture-input"
    install -d -m 700 "$DEVICEFRAMEWORK_OTA_IDENTITY_DIR"
    prepare_private_profile_build
    write_profile
    build_image a
    find_espota
    if [[ "$platform" == esp32 ]]; then
        "$project_dir/tools/check-ota-partitions.sh"
        assert_fits "$firmware_a_artifact" "$(esp32_slot_size app0 ota_0)" A
    fi
    build_image b
    if cmp -s "$firmware_a_artifact" "$firmware_b_artifact"; then
        echo "OTA fixture A and B are unexpectedly identical." >&2
        return 1
    fi
    if [[ "$platform" == esp32 ]]; then
        assert_fits "$firmware_b_artifact" "$(esp32_slot_size app1 ota_1)" B
    fi
    # Build both immutable images before touching the board. That lets the
    # serial recorder attach as soon as A finishes flashing, while the
    # fixture's attachment grace window is still active.
    flash_a
    start_serial_ota_capture
    set_target
    route_source
    df_harness_lock_ota_callback "$route_source_ip" "$host_port"
    assert_http_auth_harness
    verify_a
    if [[ "$auth_mode" == protected ]]; then
        wrong_log="$run_dir/upload-wrong-auth.log"
        if upload wrong-ota-password "$firmware_b_artifact" "$wrong_log"; then
            echo "Wrong ArduinoOTA password was accepted." >&2
            return 1
        fi
        if ! grep -Fq 'Authentication Failed' "$wrong_log"; then
            echo "Wrong-password transfer failed before the device rejected authentication: $wrong_log" >&2
            return 1
        fi
        echo "Wrong ArduinoOTA password was rejected as required."
        wait_marker 0.0.0-udp-ota-a >/dev/null
    fi
    start_reboot_monitor
    correct_log="$run_dir/upload-b.log"
    # The monitor saw A first. Only observations after this point may satisfy
    # the required outage/B sequence, so a pre-upload Wi-Fi blip cannot be
    # misreported as the OTA-triggered reboot.
    : > "$monitor_upload_started_file"
    upload "$device_password" "$firmware_b_artifact" "$correct_log" || {
        echo "ArduinoOTA upload failed: $correct_log" >&2
        explain_callback_failure "$correct_log"
        return 1
    }
    finish_reboot_monitor
    if [[ "$defer_mdns" == "yes" ]]; then
        assert_mdns_absent 10
    elif [[ -z "$device_ip" ]]; then
        # Recheck the normal hostname only after B is reachable. Resolver
        # caches can still retain A's address, so the continuous serial record
        # below separately proves B booted and ran its mDNS lifecycle.
        resolve_mdns
    fi
    response="$(wait_marker 0.0.0-udp-ota-b)"
    echo "Running B marker: $(status_version "$response")"
    sleep 1
    response="$(wait_marker 0.0.0-udp-ota-b)"
    echo "Running B marker (fresh request): $(status_version "$response")"
    stop_serial_ota_capture
    echo "ArduinoOTA $auth_mode test harness passed for $platform. Artifacts: $run_dir"
}

run_arduino() {
    validate_args
    need_common
    need_python_serial
    load_station_env
    lock_board
    # The generated profile header and object cache contain the local Wi-Fi
    # password. Create the ignored per-checkout cache owner-only.
    umask 077
    prepare_output
    # This compact random token keeps the per-run hostname below the managed
    # 24-character device-name limit while avoiding a stale mDNS collision on
    # an immediate retry in the same second.
    run_token="$(printf '%08x' "$((RANDOM * RANDOM))")"
    trap 'cleanup "$?"' EXIT
    trap 'cleanup 129' HUP
    trap 'cleanup 130' INT
    trap 'cleanup 143' TERM
    if [[ "$auth_mode" == both ]]; then
        auth_mode=protected
        run_one
        df_remove_ota_fixture_identity
        rm -f -- "$profile_file"
        profile_file=""
        auth_mode=open
        run_one
    else
        run_one
    fi
    echo "Board remains on B with test station credentials. Use cleanup only when explicitly desired."
}

run_doctor() {
    validate_doctor_args
    need_common
    lock_board
    if [[ "$defer_mdns" == yes || -n "$device_ip" ]]; then
        echo "Diagnostic transport selected; mDNS is not a success criterion."
    else
        echo "Normal mDNS will be proven after A joins Wi-Fi."
    fi
    echo "ArduinoOTA doctor passed: no board or adapter state was changed."
}

run_cleanup() {
    local cleanup_identity_dir
    validate_cleanup_args
    [[ -n "$serial_port" && -e "$serial_port" ]] || {
        echo "Serial port not found: $serial_port" >&2
        return 1
    }
    df_pio_available
    lock_board
    environment="$(environment_for)"
    install -d -m 700 "$project_dir/.pio/ota-hardware-inputs"
    cleanup_identity_dir="$(mktemp -d "$project_dir/.pio/ota-hardware-inputs/cleanup.XXXXXX")"
    chmod 700 "$cleanup_identity_dir"
    export DEVICEFRAMEWORK_OTA_IDENTITY_DIR="$cleanup_identity_dir"
    df_write_ota_fixture_identity A 0.0.0-udp-ota-a
    df_lock_ota_fixture_environment "$environment"
    if ! DEVICEFRAMEWORK_OTA_PROFILE="$project_dir/test/profiles/ota-lan-open-fixture.json" \
        df_pio run -d test/ota-harness -e "$environment" -t erase --upload-port "$serial_port"; then
        # `cleanup` deliberately has no EXIT trap because this command only
        # erases a board. Do not leave the generated header behind on a flash
        # failure where the next fixture could accidentally inherit it.
        df_remove_ota_fixture_identity
        rmdir -- "$cleanup_identity_dir" 2>/dev/null || true
        return 1
    fi
    df_remove_ota_fixture_identity
    rmdir -- "$cleanup_identity_dir" 2>/dev/null || true
    echo "The explicitly named board was erased."
}

start_serial_ota_capture() {
    local attempt capture_output
    serial_capture_log="$run_dir/serial-ota.log"
    serial_capture_ready_file="$run_dir/serial-ota-ready"
    capture_output="$run_dir/serial-ota-capture.log"
    rm -f -- "$serial_capture_log" "$serial_capture_ready_file" "$capture_output"

    # The uploader has released the serial port and fixture A intentionally
    # pauses before framework logging. Attach passively now, then retain one
    # continuous record through the real B reboot; never manufacture a reset.
    python3 "$project_dir/tools/capture-serial.py" \
        --port "$serial_port" --output "$serial_capture_log" \
        --ready-file "$serial_capture_ready_file" --deadline-seconds 600 \
        >"$capture_output" 2>&1 &
    serial_capture_pid=$!
    for attempt in $(seq 1 40); do
        [[ -e "$serial_capture_ready_file" ]] && return 0
        if ! kill -0 "$serial_capture_pid" >/dev/null 2>&1; then
            wait "$serial_capture_pid" || true
            serial_capture_pid=""
            echo "Passive serial OTA capture did not start: $capture_output" >&2
            cat "$capture_output" >&2 || true
            return 1
        fi
        sleep 0.25
    done
    echo "Passive serial OTA capture did not become ready: $capture_output" >&2
    return 1
}

stop_serial_ota_capture() {
    [[ -n "$serial_capture_pid" ]] || {
        echo "Passive serial OTA capture was not running." >&2
        return 1
    }
    if ! kill -0 "$serial_capture_pid" >/dev/null 2>&1; then
        wait "$serial_capture_pid" || true
        serial_capture_pid=""
        echo "Passive serial OTA capture stopped before B verification: $serial_capture_log" >&2
        return 1
    fi
    kill "$serial_capture_pid" >/dev/null 2>&1 || true
    if ! wait "$serial_capture_pid"; then
        serial_capture_pid=""
        echo "Passive serial OTA capture failed: $serial_capture_log" >&2
        return 1
    fi
    serial_capture_pid=""
}

case "$command" in
    doctor) run_doctor ;;
    arduino) run_arduino ;;
    cleanup) run_cleanup ;;
    *) usage ;;
esac
