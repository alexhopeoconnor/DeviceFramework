#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/device-ui-session.sh
source "$project_dir/tools/lib/device-ui-session.sh"
# shellcheck source=tools/lib/platformio.sh
source "$project_dir/tools/lib/platformio.sh"
cd "$project_dir"

usage() {
    cat <<'EOF' >&2
Usage:
  ./tools/device-ui-hardware doctor --client-interface IFACE [--take-over-client-adapter]
  ./tools/device-ui-hardware portal --platform esp8266|esp32 --port DEVICE \
      --client-interface IFACE [--take-over-client-adapter] [--env-file test/.env] \
      [--output DIRECTORY] [--keep]
  ./tools/device-ui-hardware ota-portal --platform esp8266|esp32 --port DEVICE \
      --client-interface IFACE [--take-over-client-adapter] \
      [--profile protected|open] [--output DIRECTORY] [--keep]
  ./tools/device-ui-hardware web --platform esp8266|esp32 [--port DEVICE] \
      [--env-file test/.env] [--url URL] [--auth protected|open|both] [--output DIRECTORY]
  ./tools/device-ui-hardware full --platform esp8266|esp32 --port DEVICE \
      --client-interface IFACE [--take-over-client-adapter] [--env-file test/.env] \
      [--output DIRECTORY] [--keep] [--capture-readme-media]
  ./tools/device-ui-hardware down

`portal` flashes the DeviceFramework no-Wi-Fi fixture and tests the actual
DeviceFramework -> WiFiManager portal integration. With an env file it also
provisions the board and records its station hand-off. `web` tests the normal
DeviceFramework UI, either at --url or after flashing a local station fixture.
`ota-portal` uses safe tracked no-Wi-Fi profiles to flash image A, submit image
B through the real portal firmware-update form, and require its automatic
reboot. `full` performs portal plus web coverage without touching the host
default-route Wi-Fi adapter.
EOF
    exit 2
}

command_name="${1:-}"
[[ -n "$command_name" ]] || usage
shift || true

platform=""
port=""
client_interface=""
takeover="no"
keep="no"
env_file="test/.env"
env_file_requested="no"
output_dir=""
web_url=""
capture_readme_media="no"
portal_profile="protected"
portal_profile_requested="no"
web_auth_mode="protected"
web_auth_requested="no"
ota_firmware=""
ota_firmware_a=""
ota_expected_portal_protected=""
ota_browser_prebuilt="no"
ota_serial_capture_pid=""
ota_serial_capture_ready_file=""
ota_serial_capture_log=""
# This assignment happens in the runner shell (not in a helper's command
# substitution), so the portal profile and later mDNS lookup share one token.
fixture_run_token="$(printf '%08x' "$((RANDOM * RANDOM))")"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --platform) [[ $# -ge 2 ]] || usage; platform="$2"; shift 2 ;;
        --port) [[ $# -ge 2 ]] || usage; port="$2"; shift 2 ;;
        --client-interface) [[ $# -ge 2 ]] || usage; client_interface="$2"; shift 2 ;;
        --take-over-client-adapter) takeover="yes"; shift ;;
        --keep) keep="yes"; shift ;;
        --env-file) [[ $# -ge 2 ]] || usage; env_file="$2"; env_file_requested="yes"; shift 2 ;;
        --output) [[ $# -ge 2 ]] || usage; output_dir="$2"; shift 2 ;;
        --url) [[ $# -ge 2 ]] || usage; web_url="$2"; shift 2 ;;
        --profile) [[ $# -ge 2 ]] || usage; portal_profile="$2"; portal_profile_requested="yes"; shift 2 ;;
        --auth) [[ $# -ge 2 ]] || usage; web_auth_mode="$2"; web_auth_requested="yes"; shift 2 ;;
        --capture-readme-media) capture_readme_media="yes"; shift ;;
        *) usage ;;
    esac
done

profile_file=""
station_browser_env_file=""
station_build_override_file=""
station_build_dir=""
web_expected_device_name=""
DFUI_PORTAL_CONNECTION_UUID=""
DFUI_PORTAL_CONNECTION_NAME=""
DFUI_PORTAL_CONNECTION_OWNED="no"

reject_stale_private_build_selectors() {
    local selector
    # extra_configs intentionally discovers ignored local selectors. A hard
    # host termination can leave one of this harness's private build-dir
    # selectors behind, which would silently redirect a later fixture build.
    # Do not delete it automatically: make the developer confirm that no
    # interrupted harness is still using the private directory.
    for selector in \
        "$project_dir"/test/compile-project/platformio.local.ini.zz-device-ui-hardware.* \
        "$project_dir"/test/ota-harness/platformio.local.ini.ota-hardware.*; do
        [[ -e "$selector" ]] || continue
        printf 'A stale harness-owned PlatformIO selector was found: %s\n' "$selector" >&2
        printf 'After confirming no DeviceFramework hardware runner is active, remove only it with: rm -f -- %q\n' \
            "$selector" >&2
        return 1
    done
}

require_common() {
    dfui_require ip
    dfui_require nmcli
    df_pio_available
    dfui_require python3
    dfui_require docker
    dfui_require curl
    docker compose version >/dev/null
}

require_python_serial() {
    python3 -c 'import serial' >/dev/null 2>&1 || {
        echo "Python module 'serial' (pyserial) is required for passive OTA capture." >&2
        return 1
    }
}

prepare_output_dir() {
    local output_root
    if [[ -z "$output_dir" ]]; then
        if [[ "$capture_readme_media" == "yes" ]]; then
            output_root="$project_dir/artifacts/readme-media/$(date -u +%Y%m%dT%H%M%SZ)-${platform:-unknown}"
        else
            output_root="$project_dir/artifacts/device-ui/$(date -u +%Y%m%dT%H%M%SZ)-${platform:-unknown}"
        fi
    else
        output_root="$output_dir"
    fi
    if [[ -e "$output_root" ]] && [[ -n "$(find "$output_root" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
        echo "Output directory must be empty: $output_root" >&2
        return 1
    fi
    install -d -m 700 "$output_root"
    output_dir="$(mktemp -d "$output_root/device-ui-harness.XXXXXX")"
    chmod 700 "$output_dir"
}

validate_platform() {
    [[ "$platform" == "esp8266" || "$platform" == "esp32" ]] || usage
}

validate_portal_profile() {
    case "$portal_profile" in
        protected)
            ota_expected_portal_protected="true"
            ;;
        open)
            ota_expected_portal_protected="false"
            ;;
        *)
            echo "--profile must be protected or open" >&2
            usage
            ;;
    esac
}

reject_portal_profile_option() {
    [[ "$portal_profile_requested" == "no" ]] || {
        echo "--profile is only supported by ota-portal" >&2
        usage
        return 1
    }
}

validate_web_auth_mode() {
    case "$web_auth_mode" in
        protected|open|both) ;;
        *)
            echo "--auth must be protected, open, or both" >&2
            usage
            ;;
    esac
}

reject_web_auth_option() {
    [[ "$web_auth_requested" == "no" ]] || {
        echo "--auth is only supported by the web command" >&2
        usage
        return 1
    }
}

reject_station_env_option() {
    [[ "$env_file_requested" == "no" ]] || {
        echo "ota-portal uses only tracked no-Wi-Fi profiles; --env-file is not supported" >&2
        usage
        return 1
    }
}

validate_readme_media_capture() {
    [[ "$capture_readme_media" != "yes" ]] && return 0
    [[ "$command_name" == "full" && "$platform" == "esp32" ]] || {
        echo "--capture-readme-media is supported only by full --platform esp32" >&2
        exit 2
    }
}

require_port() {
    [[ -n "$port" && -e "$port" ]] || {
        echo "Serial port not found: $port" >&2
        exit 1
    }
}

load_station_env() {
    [[ -r "$env_file" ]] || {
        echo "Missing local test credentials: $env_file (copy test/.env.example)." >&2
        exit 1
    }
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
    for key in DEVICEFRAMEWORK_TEST_WIFI_SSID DEVICEFRAMEWORK_TEST_WIFI_PASSWORD; do
        [[ -n "${!key:-}" ]] || {
            echo "$key is required in $env_file" >&2
            exit 1
        }
    done
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\n/\\n/g'
}

write_manifest() {
    local surface="$1" directory="$2" auth_mode="${3:-}"
    if [[ -n "$auth_mode" ]]; then
        printf '{"schema":1,"surface":"%s","platform":"%s","auth":"%s","created_at":"%s"}\n' \
            "$surface" "$platform" "$auth_mode" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$directory/manifest.json"
    else
        printf '{"schema":1,"surface":"%s","platform":"%s","created_at":"%s"}\n' \
            "$surface" "$platform" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$directory/manifest.json"
    fi
    chmod 600 "$directory/manifest.json"
}

write_readme_media_manifest() {
    local media_dir="$output_dir/readme-media"
    local required
    for required in device-lifecycle-tour.gif device-status.png; do
        [[ -s "$media_dir/$required" ]] || {
            echo "README media output is incomplete: $media_dir/$required" >&2
            return 1
        }
    done
    printf '{"schema":1,"project":"DeviceFramework","kind":"readme-media","status":"passed","platform":"esp32","created_at":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$media_dir/manifest.json"
    chmod 600 "$media_dir/manifest.json"
}

erase_and_upload() {
    local environment="$1"
    # Each visual fixture must start without a previous board's persisted
    # configuration. The explicitly supplied test board is immediately
    # reflashed after erase; no other serial device is selected.
    df_pio run -d test/compile-project -e "$environment" -t erase --upload-port "$port"
    wait_for_serial_port
    df_pio run -d test/compile-project -e "$environment" -t upload --upload-port "$port"
}

wait_for_serial_port() {
    local attempt
    # Some USB-UART bridges briefly remove their tty node while the erased
    # board resets.  Keep using only the caller-supplied stable path; never
    # discover or substitute another connected device.
    for attempt in {1..15}; do
        [[ -e "$port" ]] && return 0
        sleep 1
    done
    echo "Serial port did not return after erase: $port" >&2
    return 1
}

upload_portal_fixture() {
    erase_and_upload "${platform}_ui_portal"
}

portal_ota_environment() {
    local image="$1"
    printf '%s_portal_ota_%s_%s\n' "$platform" "$portal_profile" "$image"
}

portal_ota_profile_password() {
    case "$portal_profile" in
        protected) printf '%s\n' 'ota-portal-password' ;;
        open) printf '%s\n' '' ;;
        *) return 1 ;;
    esac
}

build_portal_ota_fixtures() {
    local a_environment b_environment a_source b_source
    a_environment="$(portal_ota_environment a)"
    b_environment="$(portal_ota_environment b)"
    df_pio run -d test/ota-harness -e "$a_environment"
    df_pio run -d test/ota-harness -e "$b_environment"
    a_source="$project_dir/test/ota-harness/.pio/build/${a_environment}/firmware.bin"
    b_source="$project_dir/test/ota-harness/.pio/build/${b_environment}/firmware.bin"
    [[ -s "$a_source" && -s "$b_source" ]] || {
        echo "Portal OTA build did not produce both A and B images." >&2
        return 1
    }
    if cmp -s "$a_source" "$b_source"; then
        echo "Portal OTA A and B images are unexpectedly identical." >&2
        return 1
    fi
    if [[ "$platform" == "esp32" ]]; then
        "$project_dir/tools/check-ota-partitions.sh"
    fi
    # Preserve immutable inputs before the board is touched. A subsequent
    # PlatformIO invocation cannot silently replace the browser's B upload.
    ota_firmware_a="$output_dir/${platform}-portal-ota-a.bin"
    ota_firmware="$output_dir/${platform}-portal-ota-b.bin"
    install -m 600 "$a_source" "$ota_firmware_a"
    install -m 600 "$b_source" "$ota_firmware"
    if [[ "$platform" == "esp32" ]]; then
        assert_portal_ota_firmware_fits "$ota_firmware_a" "app0" "ota_0" "A"
        assert_portal_ota_firmware_fits "$ota_firmware" "app1" "ota_1" "B"
    fi
}

esp32_portal_ota_slot_bytes() {
    local partition="$1" subtype="$2" table="$project_dir/partitions/esp32_ota_4m_no_fs.csv" value
    value="$(awk -F, -v partition="$partition" -v subtype="$subtype" '
        function trim(value) {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            return value
        }
        /^[[:space:]]*#/ || NF < 5 { next }
        trim($1) == partition && trim($2) == "app" && trim($3) == subtype {
            print trim($5)
            exit
        }
    ' "$table")"
    [[ "$value" =~ ^0x[0-9A-Fa-f]+$ ]] || {
        echo "ESP32 OTA partition table has no valid $partition application slot: $table" >&2
        return 1
    }
    printf '%d\n' "$((value))"
}

assert_portal_ota_firmware_fits() {
    local firmware="$1" partition="$2" subtype="$3" image="$4" capacity size
    capacity="$(esp32_portal_ota_slot_bytes "$partition" "$subtype")"
    size="$(wc -c < "$firmware" | tr -d '[:space:]')"
    [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 && "$size" -le "$capacity" ]] || {
        echo "Portal OTA image $image (${size:-unknown} bytes) does not fit $partition (${capacity:-unknown} bytes)." >&2
        return 1
    }
    printf 'Portal OTA image %s fits %s: %s <= %s bytes\n' "$image" "$partition" "$size" "$capacity"
}

upload_portal_ota_a_fixture() {
    local a_environment a_source
    a_environment="$(portal_ota_environment a)"
    a_source="$project_dir/test/ota-harness/.pio/build/${a_environment}/firmware.bin"
    cmp -s "$a_source" "$ota_firmware_a" || {
        echo "The PlatformIO portal A build changed after its immutable artifact was captured." >&2
        return 1
    }
    df_pio run -d test/ota-harness -e "$a_environment" -t erase --upload-port "$port"
    wait_for_serial_port
    cmp -s "$a_source" "$ota_firmware_a" || {
        echo "The PlatformIO portal A build changed while the board was being erased." >&2
        return 1
    }
    df_pio run -d test/ota-harness -e "$a_environment" -t upload --upload-port "$port"
}

start_portal_ota_serial_capture() {
    local attempt capture_output
    ota_serial_capture_log="$output_dir/serial-ota.log"
    ota_serial_capture_ready_file="$output_dir/serial-ota-ready"
    capture_output="$output_dir/serial-ota-capture.log"
    rm -f -- "$ota_serial_capture_log" "$ota_serial_capture_ready_file" "$capture_output"

    # A was just serial-flashed and has a fixture-only monitor-attachment
    # window. Keep this one passive recorder through the browser's B upload;
    # it never changes reset lines or takes ownership of the Wi-Fi adapter.
    python3 "$project_dir/tools/capture-serial.py" \
        --port "$port" --output "$ota_serial_capture_log" \
        --ready-file "$ota_serial_capture_ready_file" >"$capture_output" 2>&1 &
    ota_serial_capture_pid=$!
    for attempt in $(seq 1 40); do
        [[ -e "$ota_serial_capture_ready_file" ]] && return 0
        if ! kill -0 "$ota_serial_capture_pid" >/dev/null 2>&1; then
            wait "$ota_serial_capture_pid" || true
            ota_serial_capture_pid=""
            echo "Passive portal-OTA serial capture did not start: $capture_output" >&2
            cat "$capture_output" >&2 || true
            return 1
        fi
        sleep 0.25
    done
    echo "Passive portal-OTA serial capture did not become ready: $capture_output" >&2
    return 1
}

assert_portal_ota_serial_sequence() {
    python3 - "$ota_serial_capture_log" <<'PY'
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8", errors="replace") as source:
    lines = source.readlines()

def first_after(marker, start=0):
    for index in range(start, len(lines)):
        if marker in lines[index]:
            return index
    return None

a = first_after("DeviceFramework portal OTA fixture image: 0.0.0-portal-ota-a")
upload_started = first_after("DeviceFramework portal OTA upload started.", (a or 0) + 1)
b = first_after("DeviceFramework portal OTA fixture image: 0.0.0-portal-ota-b", (upload_started or 0) + 1)

if None in (a, upload_started, b):
    raise SystemExit("Serial portal-OTA evidence is missing its required A/upload/B ordering.")
PY
}

stop_portal_ota_serial_capture() {
    [[ -n "$ota_serial_capture_pid" ]] || {
        echo "Passive portal-OTA serial capture was not running." >&2
        return 1
    }
    if ! kill -0 "$ota_serial_capture_pid" >/dev/null 2>&1; then
        wait "$ota_serial_capture_pid" || true
        ota_serial_capture_pid=""
        echo "Passive portal-OTA serial capture stopped before B verification: $ota_serial_capture_log" >&2
        return 1
    fi
    kill "$ota_serial_capture_pid" >/dev/null 2>&1 || true
    if ! wait "$ota_serial_capture_pid"; then
        ota_serial_capture_pid=""
        echo "Passive portal-OTA serial capture failed: $ota_serial_capture_log" >&2
        return 1
    fi
    ota_serial_capture_pid=""
    if ! assert_portal_ota_serial_sequence; then
        echo "Serial portal-OTA evidence did not observe ordered A/upload/B markers: $ota_serial_capture_log" >&2
        return 1
    fi
}

portal_ota_marker_field() {
    local marker="$1" field="$2"
    printf '%s' "$marker" | python3 -c '
import json
import sys
document = json.load(sys.stdin)
value = document[sys.argv[1]]
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
' "$field"
}

wait_for_portal_ota_marker() {
    local expected_image="$1" deadline marker image version actual_policy expected_policy
    deadline=$((SECONDS + 75))
    while (( SECONDS < deadline )); do
        marker="$(curl --silent --show-error --fail --interface "$client_interface" \
            --connect-timeout 2 --max-time 2 \
            'http://192.168.4.1/api/test/firmware-marker' 2>/dev/null || true)"
        image="$(portal_ota_marker_field "$marker" image 2>/dev/null || true)"
        version="$(portal_ota_marker_field "$marker" version 2>/dev/null || true)"
        actual_policy="$(portal_ota_marker_field "$marker" portalProtected 2>/dev/null || true)"
        expected_policy="$(portal_ota_marker_field "$marker" expectedPortalProtected 2>/dev/null || true)"
        if [[ "$image" == "$expected_image" && \
              "$version" == "0.0.0-portal-ota-${expected_image,,}" && \
              "$actual_policy" == "$ota_expected_portal_protected" && \
              "$expected_policy" == "$ota_expected_portal_protected" ]]; then
            printf '%s' "$marker"
            return 0
        fi
        sleep 0.5
    done
    echo "Portal OTA fixture did not expose the expected $expected_image marker within 75 seconds." >&2
    return 1
}

verify_portal_ota_capacity() {
    local marker capacity firmware_size
    marker="$(wait_for_portal_ota_marker A)"
    capacity="$(portal_ota_marker_field "$marker" otaCapacity)"
    [[ "$capacity" =~ ^[0-9]+$ && "$capacity" -gt 0 ]] || {
        echo "Portal OTA fixture did not report a valid live OTA capacity." >&2
        return 1
    }
    firmware_size="$(wc -c < "$ota_firmware" | tr -d '[:space:]')"
    [[ "$firmware_size" =~ ^[0-9]+$ && "$firmware_size" -gt 0 ]] || {
        echo "Portal OTA image B has no valid size: $ota_firmware" >&2
        return 1
    }
    if (( firmware_size > capacity )); then
        echo "Portal OTA image B (${firmware_size} bytes) exceeds A's live update capacity (${capacity} bytes)." >&2
        return 1
    fi
}

write_station_profile() {
    local device_name device_password
    device_name="$(web_fixture_device_name)"
    case "$web_auth_mode" in
        protected) device_password=default1 ;;
        open) device_password="" ;;
        *)
            echo "A station fixture requires one web auth mode, not $web_auth_mode." >&2
            return 1
            ;;
    esac
    profile_file="$(mktemp -p /tmp deviceframework-device-ui-profile.XXXXXX)"
    chmod 600 "$profile_file"
    {
        printf '%s\n' '{'
        printf '%s\n' '  "format": 2,'
        printf '%s\n' '  "application": "deviceframework",'
        printf '  "profile": { "id": "device-ui-%s-%s", "revision": 1, "policy": "bootstrap" },\n' "$platform" "$web_auth_mode"
        printf '  "device_password": "%s",\n' "$(json_escape "$device_password")"
        printf '%s\n' '  "wifi": { "profiles": ['
        printf '    { "ssid": "%s", "password": "%s" }\n' \
            "$(json_escape "$DEVICEFRAMEWORK_TEST_WIFI_SSID")" \
            "$(json_escape "$DEVICEFRAMEWORK_TEST_WIFI_PASSWORD")"
        printf '%s\n' '  ] },'
        printf '  "parameters": { "device": "%s", "loglevel": "Verbose" }\n' \
            "$(json_escape "$device_name")"
        printf '%s\n' '}'
    } > "$profile_file"
}

prepare_private_station_build() {
    # `profile.py` compiles the local Wi-Fi credential into a generated header.
    # Keep that header, objects, and firmware in a private temporary directory
    # rather than a potentially group-readable project `.pio` tree. It is
    # deleted immediately after serial upload; browser artifacts never need a
    # firmware that embeds a developer's Wi-Fi password. The ignored selector
    # sorts after ordinary developer-local selectors and exists only for this
    # invocation.
    station_build_dir="$(mktemp -d /tmp/deviceframework-device-ui-build.XXXXXX)"
    chmod 700 "$station_build_dir"
    station_build_override_file="$(mktemp "$project_dir/test/compile-project/platformio.local.ini.zz-device-ui-hardware.XXXXXX")"
    chmod 600 "$station_build_override_file"
    printf '[platformio]\nbuild_dir = %s\n' "$station_build_dir" > "$station_build_override_file"
}

remove_private_station_build_override() {
    [[ -z "$station_build_override_file" ]] || rm -f -- "$station_build_override_file"
    station_build_override_file=""
}

remove_private_station_build() {
    [[ -z "$station_build_dir" ]] && return 0
    case "$station_build_dir" in
        /tmp/deviceframework-device-ui-build.*)
            rm -rf -- "$station_build_dir"
            ;;
        *)
            echo "Refusing to remove an unexpected private station build directory: $station_build_dir" >&2
            return 1
            ;;
    esac
    station_build_dir=""
}

prepare_station_browser_env() {
    # Playwright needs only these two values to submit the portal form. Never
    # mount a shared test/.env (which can also contain MQTT credentials) into
    # a container or retain it alongside browser evidence.
    [[ -n "${DEVICEFRAMEWORK_TEST_WIFI_SSID:-}" && -n "${DEVICEFRAMEWORK_TEST_WIFI_PASSWORD:-}" ]] || {
        echo "Station Wi-Fi credentials were not loaded for the portal browser test." >&2
        return 1
    }
    station_browser_env_file="$(mktemp -p /tmp deviceframework-device-ui-station.XXXXXX)"
    chmod 600 "$station_browser_env_file"
    {
        printf 'DEVICEFRAMEWORK_TEST_WIFI_SSID=%s\n' "$DEVICEFRAMEWORK_TEST_WIFI_SSID"
        printf 'DEVICEFRAMEWORK_TEST_WIFI_PASSWORD=%s\n' "$DEVICEFRAMEWORK_TEST_WIFI_PASSWORD"
    } > "$station_browser_env_file"
}

remove_station_browser_env() {
    [[ -z "$station_browser_env_file" ]] || rm -f -- "$station_browser_env_file"
    station_browser_env_file=""
}

upload_station_fixture() {
    load_station_env
    write_station_profile
    umask 077
    prepare_private_station_build
    DEVICEFRAMEWORK_HARDWARE_PROFILE="$profile_file" \
        erase_and_upload "${platform}_profile_hardware"
    rm -f -- "$profile_file"
    profile_file=""
    remove_private_station_build_override
    remove_private_station_build
}

web_fixture_hostname() {
    printf '%s.local\n' "$(web_fixture_device_name)"
}

fixture_platform_token() {
    case "$platform" in
        esp8266) printf '%s\n' 8266 ;;
        esp32) printf '%s\n' 32 ;;
        *) return 1 ;;
    esac
}

ensure_fixture_run_token() {
    # Kept as a named invariant for the identity helpers. The value is created
    # above in this shell so command substitution cannot accidentally generate
    # a different name for the profile and its later resolver check.
    [[ -n "$fixture_run_token" ]]
}

web_fixture_device_name() {
    local platform_token auth_token
    ensure_fixture_run_token
    platform_token="$(fixture_platform_token)"
    case "$web_auth_mode" in
        protected) auth_token=p ;;
        open) auth_token=o ;;
        *) return 1 ;;
    esac
    printf 'dfweb-%s-%s-%s\n' "$platform_token" "$auth_token" "$fixture_run_token"
}

portal_fixture_device_name() {
    local platform_token
    ensure_fixture_run_token
    platform_token="$(fixture_platform_token)"
    printf 'dfportal-%s-%s\n' "$platform_token" "$fixture_run_token"
}

web_status_document() {
    local url="$1"
    if [[ "$web_auth_mode" == protected ]]; then
        curl --silent --show-error --connect-timeout 1 --max-time 2 \
            -u 'admin:default1' "${url%/}/api/status" 2>/dev/null
    else
        curl --silent --show-error --connect-timeout 1 --max-time 2 \
            "${url%/}/api/status" 2>/dev/null
    fi
}

web_status_device_name() {
    python3 -c 'import json,sys; print(json.load(sys.stdin)["runtime"]["device"]["name"])'
}

web_status_is_connected() {
    python3 -c 'import json,sys; status=json.load(sys.stdin); sys.exit(0 if status["runtime"]["wifi"]["connected"] is True else 1)'
}

wait_for_web_url() {
    local hostname="${1:-df-web-${platform}.local}" expected_device_name="${2:-${hostname%.local}}" avahi_ip="" system_ip="" attempt document observed_device_name
    dfui_require avahi-resolve
    dfui_require getent
    for attempt in {1..45}; do
        # mDNS is expected to be absent until the station fixture has joined.
        # Require Avahi and the system resolver to agree rather than using a
        # station IP reported by the departing portal or a stale resolver path.
        avahi_ip="$(avahi-resolve -4 -n "$hostname" 2>/dev/null | awk 'NR == 1 { print $2; exit }' || true)"
        system_ip="$(getent ahostsv4 "$hostname" 2>/dev/null | awk 'NR == 1 { print $1; exit }' || true)"
        [[ -n "$avahi_ip" && "$avahi_ip" == "$system_ip" ]] && break
        sleep 1
    done
    [[ -n "$avahi_ip" && "$avahi_ip" == "$system_ip" ]] || {
        echo "Could not resolve $hostname through both Avahi and the system resolver; pass --url only to test an already-running endpoint explicitly." >&2
        return 1
    }
    # Playwright runs in a pinned container image which deliberately does not
    # own the host's NSS mDNS configuration. Preserve the hostname in the
    # browser URL and pass only this fresh, dual-resolver result as its
    # ephemeral host mapping; neither a fixed address nor portal hand-off IP
    # can make the normal station test harness pass.
    export DEVICE_UI_HOSTNAME="$hostname"
    export DEVICE_UI_HOST_IP="$avahi_ip"
    for attempt in {1..45}; do
        document="$(web_status_document "http://${hostname}" 2>/dev/null || true)"
        observed_device_name="$(printf '%s' "$document" | web_status_device_name 2>/dev/null || true)"
        [[ "$observed_device_name" == "$expected_device_name" ]] && {
            printf 'http://%s\n' "$hostname"
            return 0
        }
        sleep 1
    done
    echo "DeviceFramework web UI did not become ready at $hostname" >&2
    return 1
}

wait_for_station_status() {
    local url="$1" expected_device_name="${2:-}" attempt status observed_device_name
    for attempt in {1..45}; do
        if [[ "$web_auth_mode" == protected ]]; then
            status="$(curl --silent --connect-timeout 1 --max-time 2 \
                -u 'admin:default1' "${url%/}/api/status" 2>/dev/null || true)"
        else
            status="$(curl --silent --connect-timeout 1 --max-time 2 \
                "${url%/}/api/status" 2>/dev/null || true)"
        fi
        # The normal web fixture has already proved that this is the intended
        # board. Do not start page screenshots until its cached runtime status
        # has also observed the completed AP-to-STA transition.
        observed_device_name="$(printf '%s' "$status" | web_status_device_name 2>/dev/null || true)"
        if printf '%s' "$status" | web_status_is_connected >/dev/null 2>&1 && \
           { [[ -z "$expected_device_name" ]] || [[ "$observed_device_name" == "$expected_device_name" ]]; }; then
            return 0
        fi
        sleep 1
    done
    echo "DeviceFramework station did not report a connected Wi-Fi state at $url" >&2
    return 1
}

prepare_portal_ota_browser() {
    local directory="$1"
    [[ -n "$ota_firmware" && -s "$ota_firmware" ]] || {
        echo "Portal OTA browser prebuild has no immutable image B." >&2
        return 1
    }
    # Build before A is flashed. A first Playwright image build can otherwise
    # outlast the fixture's finite portal timeout and turn a correct device
    # into a false failure before the browser has even started.
    export DEVICE_UI_MODE=ota-portal
    export DEVICE_UI_URL='http://192.168.4.1'
    export DEVICE_UI_ARTIFACT_DIR="$directory"
    export DEVICE_UI_USERNAME='admin'
    export DEVICE_UI_PASSWORD='default1'
    export DEVICE_UI_WEB_AUTH=protected
    export DEVICE_UI_TEST_DEVICE_NAME="$(portal_fixture_device_name)"
    export DEVICE_UI_CAPTURE_README_MEDIA=0
    export DEVICE_UI_DOCKER_TARGET=device-ui
    export DEVICE_UI_OTA_FIRMWARE_HOST="$ota_firmware"
    export DEVICE_UI_OTA_EXPECTED_IMAGE='B'
    export DEVICE_UI_OTA_EXPECTED_PORTAL_PROTECTED="$ota_expected_portal_protected"
    export LOCAL_UID="$(id -u)"
    export LOCAL_GID="$(id -g)"
    docker compose \
        -f "$project_dir/tests/device-ui/compose.yaml" \
        -f "$project_dir/tests/device-ui/compose.ota.yaml" \
        build device-ui
    ota_browser_prebuilt="yes"
}

run_browser() {
    local mode="$1" url="$2" directory="$3" station_mount="" manifest_auth=""
    install -d -m 700 "$directory"
    if [[ "$mode" == web ]]; then
        manifest_auth="$web_auth_mode"
    fi
    write_manifest "$mode" "$directory" "$manifest_auth"
    export DEVICE_UI_MODE="$mode"
    export DEVICE_UI_URL="$url"
    export DEVICE_UI_ARTIFACT_DIR="$directory"
    export DEVICE_UI_WEB_AUTH="$web_auth_mode"
    if [[ "$mode" == web && "$web_auth_mode" == open ]]; then
        export DEVICE_UI_USERNAME=''
        export DEVICE_UI_PASSWORD=''
    else
        export DEVICE_UI_USERNAME='admin'
        export DEVICE_UI_PASSWORD='default1'
    fi
    case "$mode" in
        web) export DEVICE_UI_TEST_DEVICE_NAME="$web_expected_device_name" ;;
        *) export DEVICE_UI_TEST_DEVICE_NAME="$(portal_fixture_device_name)" ;;
    esac
    export LOCAL_UID="$(id -u)"
    export LOCAL_GID="$(id -g)"
    if [[ "$capture_readme_media" == "yes" ]]; then
        export DEVICE_UI_CAPTURE_README_MEDIA=1
        export DEVICE_UI_DOCKER_TARGET=media
    else
        export DEVICE_UI_CAPTURE_README_MEDIA=0
        export DEVICE_UI_DOCKER_TARGET=device-ui
    fi
    compose_files=(-f "$project_dir/tests/device-ui/compose.yaml")
    case "$mode" in
        portal)
            if [[ -r "$env_file" ]]; then
                load_station_env
                prepare_station_browser_env
                station_mount="$station_browser_env_file"
                export DEVICE_UI_STATION_ENV_HOST="$station_mount"
                compose_files+=(-f "$project_dir/tests/device-ui/compose.station.yaml")
            fi
            ;;
        ota-portal)
            [[ -n "$ota_firmware" && -s "$ota_firmware" ]] || {
                echo "Portal OTA browser test has no image B to mount." >&2
                return 1
            }
            export DEVICE_UI_OTA_FIRMWARE_HOST="$ota_firmware"
            export DEVICE_UI_OTA_EXPECTED_IMAGE='B'
            export DEVICE_UI_OTA_EXPECTED_PORTAL_PROTECTED="$ota_expected_portal_protected"
            compose_files+=(-f "$project_dir/tests/device-ui/compose.ota.yaml")
            ;;
    esac
    local browser_status=0
    if [[ "$mode" != "ota-portal" || "$ota_browser_prebuilt" != "yes" ]]; then
        docker compose "${compose_files[@]}" build device-ui
    fi
    if docker compose "${compose_files[@]}" run --rm device-ui; then
        browser_status=0
    else
        browser_status=$?
    fi
    sanitize_browser_artifacts "$directory" "$mode"
    remove_station_browser_env
    return "$browser_status"
}

render_readme_media() {
    local directory="$1"
    export DEVICE_UI_MODE=media-render
    export DEVICE_UI_URL=http://127.0.0.1
    export DEVICE_UI_ARTIFACT_DIR="$directory"
    export DEVICE_UI_WEB_AUTH=protected
    export DEVICE_UI_USERNAME=admin
    export DEVICE_UI_PASSWORD=default1
    export DEVICE_UI_CAPTURE_README_MEDIA=1
    export DEVICE_UI_DOCKER_TARGET=media
    docker compose -f "$project_dir/tests/device-ui/compose.yaml" build device-ui
    docker compose -f "$project_dir/tests/device-ui/compose.yaml" \
        run --rm --entrypoint /work/render-readme-media.sh device-ui
}

sanitize_browser_artifacts() {
    local directory="$1" mode="$2" key value
    local -a matching_files=()

    # Portal OTA uses tracked, non-secret profiles and mounts only firmware B.
    # Do not read a developer's ignored station environment merely to sanitize
    # artifacts that cannot contain it.
    [[ "$mode" != "ota-portal" ]] || return 0
    [[ -r "$env_file" ]] || return 0
    # Failure-only Playwright diagnostics can include a DOM snapshot. A password
    # field is visually masked in screenshots but its DOM value may be present
    # in that text file, so remove any artifact containing a known local secret.
    # The selected credentials remain mounted read-only inside Docker only.
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
    for key in DEVICEFRAMEWORK_TEST_WIFI_SSID DEVICEFRAMEWORK_TEST_WIFI_PASSWORD DEVICEFRAMEWORK_TEST_MQTT_PASSWORD; do
        value="${!key:-}"
        [[ -n "$value" ]] || continue
        mapfile -t matching_files < <(grep -r -l -a -F -- "$value" "$directory" 2>/dev/null || true)
        if (( ${#matching_files[@]} > 0 )); then
            printf 'Removing browser evidence containing a local test credential.\n' >&2
            rm -f -- "${matching_files[@]}"
        fi
    done
}

start_portal_connection() {
    local ssid
    require_port
    [[ -n "$client_interface" ]] || usage
    # Select the real NetworkManager authorization path before inspecting the
    # secondary adapter. A headless shell must not mistake a denied inspection
    # for an idle adapter and then overwrite a connection it does not own.
    dfui_prepare_networkmanager_authorization
    dfui_require_client_adapter "$client_interface" "$takeover"
    dfui_require_no_active_session
    upload_portal_fixture
    ssid="$(dfui_portal_ssid "$platform")"
    dfui_create_portal_connection "$client_interface" "$ssid" 'default1' no "$platform"
    dfui_verify_portal_route "$client_interface"
}

start_portal_ota_connection() {
    local ssid password
    require_port
    [[ -n "$client_interface" ]] || usage
    dfui_prepare_networkmanager_authorization
    dfui_require_client_adapter "$client_interface" "$takeover"
    dfui_require_no_active_session
    upload_portal_ota_a_fixture
    start_portal_ota_serial_capture
    ssid="$(dfui_portal_ssid "$platform")"
    password="$(portal_ota_profile_password)"
    # The board must reboot itself after POST /u. Retain automatic reconnect
    # on this one disposable, never-default adapter connection so the browser
    # can observe the returning portal; cleanup still removes it on exit.
    dfui_create_portal_connection "$client_interface" "$ssid" "$password" yes "$platform"
    dfui_verify_portal_route "$client_interface"
    verify_portal_ota_capacity
}

run_portal() {
    local directory="$1"
    start_portal_connection
    run_browser portal 'http://192.168.4.1' "$directory"
}

run_portal_ota() {
    local directory="$1"
    build_portal_ota_fixtures
    prepare_portal_ota_browser "$directory"
    start_portal_ota_connection
    run_browser ota-portal 'http://192.168.4.1' "$directory"
    stop_portal_ota_serial_capture
}

run_web() {
    local directory="$1" url="$web_url"
    if [[ -n "$url" ]]; then
        # An explicit endpoint check is not an owned mDNS run. Do not inherit a
        # previous fixture's ephemeral hostname mapping into its browser
        # container, which could make a caller's URL appear to use mDNS.
        unset DEVICE_UI_HOSTNAME DEVICE_UI_HOST_IP
        web_expected_device_name=""
    else
        require_port
        web_expected_device_name="$(web_fixture_device_name)"
        upload_station_fixture
        url="$(wait_for_web_url "$(web_fixture_hostname)" "$web_expected_device_name")"
    fi
    run_browser web "$url" "$directory"
}

write_web_auth_matrix() {
    local directory="$1"
    printf '{"schema":1,"surface":"web","platform":"%s","auth":"both","runs":["open","protected"],"created_at":"%s"}\n' \
        "$platform" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$directory/web-auth-matrix.json"
    chmod 600 "$directory/web-auth-matrix.json"
}

run_web_auth_matrix() {
    local directory="$1"
    if [[ "$web_auth_mode" != both ]]; then
        run_web "$directory"
        return
    fi
    # Leave the named board protected after a successful matrix. Each mode
    # starts from serial erase, so no saved profile/auth state can cross over.
    web_auth_mode=open
    run_web "$directory/web-open"
    web_auth_mode=protected
    run_web "$directory/web-protected"
    write_web_auth_matrix "$directory"
}

cleanup() {
    local status="${1:-$?}"
    # Signal handlers must stop the run rather than return into a later board
    # operation.  Remove only the temporary connection this process created;
    # this also covers either side of its pending-to-active state transition.
    trap - EXIT HUP INT TERM
    [[ -z "$ota_serial_capture_pid" ]] || kill "$ota_serial_capture_pid" >/dev/null 2>&1 || true
    [[ -z "$ota_serial_capture_pid" ]] || wait "$ota_serial_capture_pid" >/dev/null 2>&1 || true
    ota_serial_capture_pid=""
    [[ -z "$profile_file" ]] || rm -f -- "$profile_file"
    remove_station_browser_env
    remove_private_station_build_override
    remove_private_station_build
    if [[ "${DFUI_PORTAL_CONNECTION_OWNED:-no}" == "yes" ]] && \
        { (( status != 0 )) || [[ "$keep" != "yes" ]]; }; then
        if ! dfui_remove_portal_connection; then
            # Preserve the original failure when there was one, but do not
            # report a successful browser/OTA run if its disposable portal
            # connection could not be removed and recovered later with `down`.
            (( status != 0 )) || status=1
        fi
    fi
    exit "$status"
}

finish_portal_connection() {
    # Success must not be announced until the runner has confirmed deletion of
    # its generated connection. --keep intentionally leaves the recorded
    # connection for the developer to remove with `down`.
    if [[ "${DFUI_PORTAL_CONNECTION_OWNED:-no}" == "yes" && "$keep" != "yes" ]]; then
        dfui_remove_portal_connection
    fi
}

case "$command_name" in
    doctor)
        reject_portal_profile_option
        reject_web_auth_option
        [[ "$capture_readme_media" == "no" ]] || usage
        [[ -n "$client_interface" ]] || usage
        require_common
        dfui_acquire_hardware_lock
        # Doctor is read-only, but must choose the same authorization path as
        # a real portal run before it declares a secondary adapter safe.
        dfui_prepare_networkmanager_authorization
        dfui_require_client_adapter "$client_interface" "$takeover"
        dfui_report_networkmanager_authorization
        echo "DeviceFramework device-UI prerequisites are ready; primary route is untouched."
        ;;
    down)
        reject_portal_profile_option
        reject_web_auth_option
        [[ -z "$platform$port$client_interface$output_dir$web_url" && "$capture_readme_media" == "no" ]] || usage
        dfui_acquire_hardware_lock
        dfui_load_state
        dfui_prepare_networkmanager_authorization
        dfui_remove_portal_connection
        echo "DeviceFramework portal client connection removed."
        ;;
    portal)
        reject_portal_profile_option
        reject_web_auth_option
        validate_platform
        validate_readme_media_capture
        require_common
        dfui_acquire_hardware_lock
        reject_stale_private_build_selectors
        prepare_output_dir
        trap 'cleanup "$?"' EXIT
        trap 'cleanup 129' HUP
        trap 'cleanup 130' INT
        trap 'cleanup 143' TERM
        run_portal "$output_dir"
        if ! finish_portal_connection; then
            trap - EXIT HUP INT TERM
            exit 1
        fi
        echo "DeviceFramework portal integration test harness passed. Artifacts: $output_dir"
        [[ "$keep" != "yes" ]] || echo "Portal client remains connected; run ./tools/device-ui-hardware down when finished."
        ;;
    ota-portal)
        reject_web_auth_option
        validate_platform
        validate_portal_profile
        reject_station_env_option
        validate_readme_media_capture
        require_common
        require_python_serial
        dfui_acquire_hardware_lock
        reject_stale_private_build_selectors
        prepare_output_dir
        trap 'cleanup "$?"' EXIT
        trap 'cleanup 129' HUP
        trap 'cleanup 130' INT
        trap 'cleanup 143' TERM
        run_portal_ota "$output_dir"
        if ! finish_portal_connection; then
            trap - EXIT HUP INT TERM
            exit 1
        fi
        echo "DeviceFramework portal OTA test harness passed (${portal_profile}). Artifacts: $output_dir"
        [[ "$keep" != "yes" ]] || echo "Portal client remains connected; run ./tools/device-ui-hardware down when finished."
        ;;
    web)
        reject_portal_profile_option
        validate_web_auth_mode
        if [[ "$web_auth_mode" == both && -n "$web_url" ]]; then
            echo "--auth both requires an owned --port fixture, not --url." >&2
            usage
        fi
        validate_platform
        validate_readme_media_capture
        require_common
        dfui_acquire_hardware_lock
        [[ -n "$web_url" ]] || reject_stale_private_build_selectors
        prepare_output_dir
        trap 'cleanup "$?"' EXIT
        trap 'cleanup 129' HUP
        trap 'cleanup 130' INT
        trap 'cleanup 143' TERM
        run_web_auth_matrix "$output_dir"
        echo "DeviceFramework web UI test harness passed. Artifacts: $output_dir"
        ;;
    full)
        reject_portal_profile_option
        reject_web_auth_option
        validate_platform
        validate_readme_media_capture
        require_common
        require_port
        [[ -n "$client_interface" ]] || usage
        load_station_env
        dfui_acquire_hardware_lock
        reject_stale_private_build_selectors
        prepare_output_dir
        trap 'cleanup "$?"' EXIT
        trap 'cleanup 129' HUP
        trap 'cleanup 130' INT
        trap 'cleanup 143' TERM
        run_portal "$output_dir/portal"
        handoff_file="$output_dir/portal/portal-handoff.json"
        [[ -r "$handoff_file" ]] || {
            echo "Portal browser test harness did not record a station hand-off." >&2
            exit 1
        }
        # A portal response can contain its transient station IP, but using it
        # would bypass the normal mDNS test harness. The accepted portal save
        # is only the hand-off evidence; the next browser request must reach
        # the newly provisioned board through its unique hostname.
        web_expected_device_name="$(portal_fixture_device_name)"
        web_url="$(wait_for_web_url "${web_expected_device_name}.local" "$web_expected_device_name")"
        wait_for_station_status "$web_url" "$web_expected_device_name"
        # wait_for_web_url already established the dual-resolver mDNS mapping.
        # Calling run_web here would mistake this owned URL for --url and clear
        # that mapping before Playwright starts.
        run_browser web "$web_url" "$output_dir/web"
        write_manifest full "$output_dir"
        if [[ "$capture_readme_media" == "yes" ]]; then
            render_readme_media "$output_dir"
            write_readme_media_manifest
        fi
        if ! finish_portal_connection; then
            trap - EXIT HUP INT TERM
            exit 1
        fi
        echo "DeviceFramework full portal-to-web test harness passed. Artifacts: $output_dir"
        [[ "$keep" != "yes" ]] || echo "Portal client remains connected; run ./tools/device-ui-hardware down when finished."
        ;;
    *) usage ;;
esac
