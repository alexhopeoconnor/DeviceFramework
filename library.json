{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "DeviceFramework",
  "version": "2.5.1",
  "build": {
    "extraScript": "tools/platformio/profile.py",
    "flags": [
      "-DDEVICEFRAMEWORK_LIBRARY_VERSION=\\\"2.5.1\\\""
    ]
  },
  "description": "Reusable ESP8266 and ESP32 device framework with WiFi provisioning, MQTT, OTA, local web UI, and Home Assistant integration.",
  "keywords": [
    "iot",
    "esp8266",
    "esp32",
    "wifi",
    "mqtt",
    "ota",
    "mdns",
    "home-assistant",
    "web-interface"
  ],
  "authors": [
    {
      "name": "Alex Hope-O\u2019Connor",
      "url": "https://github.com/alexhopeoconnor",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/alexhopeoconnor/DeviceFramework",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexhopeoconnor/DeviceFramework.git"
  },
  "frameworks": "arduino",
  "platforms": [
    "espressif8266",
    "espressif32"
  ],
  "dependencies": [
    {
      "name": "WiFiManager",
      "version": "https://github.com/alexhopeoconnor/WiFiManager.git#v3.2.0"
    },
    {
      "name": "DeviceFrameworkTemplateEngine",
      "version": "https://github.com/alexhopeoconnor/DFTE.git#v1.1.0"
    },
    {
      "name": "home-assistant-integration",
      "version": "https://github.com/alexhopeoconnor/arduino-home-assistant.git#v3.1.0"
    },
    { "owner": "madpilot", "name": "mDNSResolver", "version": "^0.3.0" },
    { "owner": "knolleary", "name": "PubSubClient", "version": "2.8.0" },
    { "owner": "bblanchon", "name": "ArduinoJson", "version": "7.4.2" },
    { "owner": "esp32async", "name": "ESPAsyncWebServer", "version": "3.9.1" },
    {
      "owner": "esp32async",
      "name": "ESPAsyncTCP",
      "version": "^2.0.0",
      "platforms": "espressif8266"
    },
    {
      "owner": "esp32async",
      "name": "AsyncTCP",
      "version": "^3.4.9",
      "platforms": "espressif32"
    }
  ],
  "export": {
    "include": [
      "include",
      "assets",
      "src",
      "examples",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "tools",
      "library.json"
    ]
  }
}
