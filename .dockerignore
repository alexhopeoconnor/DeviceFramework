# This repository does not normally use its root as a Docker build context;
# tests/device-ui/compose.yaml deliberately narrows its context to the browser
# harness directory. Keep this defensive fallback too: a future root-context
# image must not send a developer's environment file, generated build output,
# or browser evidence to the Docker daemon.
.git
.pio
**/.pio
artifacts
**/artifacts
node_modules
**/node_modules
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
test/**/test_config.generated.h
platformio.local.ini
platformio.local.ini.*
**/platformio.local.ini
**/platformio.local.ini.*
__pycache__
**/__pycache__
